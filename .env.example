# =============================================================================
# NEETPAY BACKEND ENVIRONMENT CONFIGURATION (V1)
# =============================================================================

# Server Port and Environment
PORT=4000
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/neetpay_db?schema=public"

# Application Secrets
JWT_SECRET="neetpay_jwt_secret_development_only_change_in_production"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" # 32-byte hex for AES-256

# CORS Origin
CORS_ORIGIN="http://localhost:5173,https://neetpay.web.id"

# Worker Polling Intervals (milliseconds)
WORKER_PAYMENT_POLL_INTERVAL_MS=5000
WORKER_WEBHOOK_POLL_INTERVAL_MS=3000

# Initial Admin Seed Credentials
ADMIN_EMAIL="admin@neetpay.web.id"
ADMIN_PASSWORD="ChangeMeInProduction123!"
ADMIN_NAME="NeetPay Admin"
